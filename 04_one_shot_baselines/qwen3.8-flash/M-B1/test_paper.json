        {
          "id": "q23_1",
          "text": "计算生成二氧化碳的质量。",
          "points": 2
        },
        {
          "id": "q23_2",
          "text": "计算该石灰石样品中碳酸钙的质量分数。",
          "points": 8
        }
      ],
      "answer": "4.4 g",
      "scoring_points": [
        {
          "description": "根据质量守恒定律算出CO₂质量：12.5+90-98.1=4.4 g，得2分。",
          "points": 2
        },
        {
          "description": "列出化学方程式 CaCO₃ + 2HCl = CaCl₂ + H₂O + CO₂↑，得1分。",
          "points": 1
        },
        {
          "description": "设未知数，列出比例式：100/x = 44/4.4，求出x=10 g，得3分。",
          "points": 3
        },
        {
          "description": "计算质量分数：10/12.5 × 100% = 80%，得2分。",
          "points": 2
        },
        {
          "description": "结果单位、有效数字等规范，得2分（若上述步骤有误但结果正确酌情给分，全错不得分）。",
